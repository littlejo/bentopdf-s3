# Example rclone configuration. The section name is the value of S3_REMOTE.
# Point RCLONE_CONFIG at this file (mounted from a Secret in Kubernetes).
#
# Alternatively, skip the file and define the remote with environment
# variables, which rclone reads natively:
#   RCLONE_CONFIG_S3_TYPE=s3
#   RCLONE_CONFIG_S3_PROVIDER=Other
#   RCLONE_CONFIG_S3_ENDPOINT=https://s3.example.com
#   RCLONE_CONFIG_S3_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=...

# Generic S3-compatible service (MinIO, Ceph RGW, Garage, Scaleway, OVH, ...)
[s3]
type = s3
provider = Other
endpoint = https://s3.example.com
region = us-east-1
access_key_id = CHANGE_ME
secret_access_key = CHANGE_ME
# Skip the "create bucket" call when the credentials cannot create buckets.
no_check_bucket = true
# Uncomment if the service requires path-style URLs.
# force_path_style = true

# AWS S3
# [aws]
# type = s3
# provider = AWS
# region = eu-west-3
# env_auth = false
# access_key_id = CHANGE_ME
# secret_access_key = CHANGE_ME
